{% assign featured_collection = collections[section.settings.collection] %}
<section class="amie-section" id="bestsellers"><div class="amie-shell"><div class="amie-section__heading"><div><div class="amie-kicker">Loved most</div><h2>{{ section.settings.heading }}</h2></div>{% if featured_collection != blank %}<a class="amie-button" href="{{ featured_collection.url }}">Shop all products →</a>{% endif %}</div><div class="amie-products">{% if featured_collection != blank %}{% for product in featured_collection.products limit: 6 %}<article class="amie-product"><a class="amie-product__image" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{% endif %}</a><div class="amie-product__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><span class="amie-price">{{ product.price | money }}</span>{% if product.compare_at_price > product.price %}<span class="amie-compare">{{ product.compare_at_price | money }}</span>{% endif %}</div></article>{% endfor %}{% else %}<p>Choose a collection in this section's settings to show products.</p>{% endif %}</div></div></section>
{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"heading","label":"Heading","default":"Bestsellers"},{"type":"collection","id":"collection","label":"Collection"}],"presets":[{"name":"Featured products"}]}{% endschema %}
