<section class="amie-section amie-section--cream">
  <div class="amie-shell">
    <div class="amie-promo-grid">
      <article class="amie-promo amie-promo--blue">
        <span class="amie-pill">New Born (0-6M)</span>
        <h3>New Born New Wonders</h3>
        <p>Soft organic swaddles, coming-home bodysuits and gentle essentials for sweetest beginnings.</p>
        <a class="amie-button" href="{{ routes.collections_url }}/all">Explore New Born <span aria-hidden="true">→</span></a>
        <img src="{{ 'fhd-banner-newborn.jpg' | asset_url }}" alt="Newborn essentials" class="amie-promo__img" width="400" height="400" loading="lazy">
      </article>

      <article class="amie-promo amie-promo--green">
        <span class="amie-pill">Kids 3-10 Yrs</span>
        <h3>Play. Explore. Grow.</h3>
        <p>Durable cotton tees, floral frill dresses and linen shorts sets crafted for active play.</p>
        <a class="amie-button" href="{{ routes.collections_url }}/all">Shop Kids Collection <span aria-hidden="true">→</span></a>
        <img src="{{ 'fhd-banner-kids.jpg' | asset_url }}" alt="Kids collection" class="amie-promo__img" width="400" height="400" loading="lazy">
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promotional collections",
  "settings": [],
  "presets": [
    {
      "name": "Promotional collections"
    }
  ]
}
{% endschema %}
