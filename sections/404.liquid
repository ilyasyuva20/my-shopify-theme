<section class="amie-section amie-section--cream">
  <div class="amie-shell" style="text-align: center; max-width: 800px; margin: 0 auto;">
    <div class="amie-kicker" style="margin-bottom: 8px;">AMIE'S BABY STUDIO</div>
    <h1 style="font-family: var(--font-display); font-size: 36px; font-weight: 800; color: #1b2d42; margin: 0 0 12px;">Explore Our Collections</h1>
    <p style="color: #475569; font-size: 15px; line-height: 1.6; margin-bottom: 24px;">
      Looking for something special? Browse our organic newborn essentials, kids wear, soft pre-walker footwear, and care hampers below!
    </p>

    <div style="display: flex; gap: 12px; justify-content: center; margin-bottom: 40px;">
      <a href="{{ routes.collections_url }}/all" class="amie-button" style="background: #0082a6;">Browse All Products <span aria-hidden="true">→</span></a>
      <a href="{{ routes.root_url }}" class="amie-button" style="background: #f87171;">Back To Home</a>
    </div>
  </div>

  <div class="amie-shell">
    {% section 'amie-collections' %}
  </div>
</section>

