<section class="amie-section amie-section--cream">
  <div class="amie-shell">
    <div class="amie-section__heading">
      <div>
        <div class="amie-kicker">@amiesbabystudio</div>
        <h2>{{ section.settings.heading | default: "Little moments, shared" }}</h2>
      </div>
    </div>
    <div class="amie-social-grid">
      {% assign images = 'fhd-banner-newborn.jpg,insta-girls.jpg,b-footwear.jpg,insta-blankets.jpg,p-careset.jpg,fhd-banner-kids.jpg,p-boysset.jpg,insta-pink-dress.jpg' | split: ',' %}
      {% for img in images %}
        <img src="{{ img | asset_url }}" alt="Amie’s Baby Studio" width="300" height="300" loading="lazy">
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Little moments, shared"
    }
  ],
  "presets": [
    {
      "name": "Social gallery"
    }
  ]
}
{% endschema %}
