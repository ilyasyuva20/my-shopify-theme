<section class="amie-section">
  <div class="amie-shell">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start;">
      <!-- Product Images -->
      <div style="border-radius: 24px; overflow: hidden; background: #f8fafc; border: 1px solid #e2e8f0;">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" width="600" height="600" style="width: 100%; height: auto; object-fit: cover;">
        {% else %}
          <img src="{{ 'fhd-banner-kids.jpg' | asset_url }}" alt="{{ product.title | escape }}" width="600" height="600" style="width: 100%; height: auto; object-fit: cover;">
        {% endif %}
      </div>

      <!-- Product Information & Form -->
      <div>
        <span class="amie-pill" style="margin-bottom: 12px; background: #e5f3e7; color: #10b981; border: 0;">100% Organic &amp; Certified</span>
        <h1 style="font-family: var(--font-display); font-size: 32px; font-weight: 800; color: #1b2d42; margin: 8px 0 12px;">{{ product.title | default: "Organic Cotton Kids Outfit" }}</h1>
        <div style="font-family: var(--font-display); font-size: 26px; font-weight: 900; color: #0082a6; margin-bottom: 16px;">
          {{ product.price | money | default: "₹1,299" }}
        </div>

        <div style="color: #475569; font-size: 14px; line-height: 1.6; margin-bottom: 24px;">
          {{ product.description | default: "Thoughtfully crafted from 100% GOTS-certified organic cotton. Soft, breathable, hypoallergenic, and gentle on sensitive skin." }}
        </div>

        {% form 'product', product %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          <div style="display: flex; gap: 16px; align-items: center; margin-bottom: 24px;">
            <label style="font-weight: 700; font-size: 13px; color: #1e293b;">Quantity:</label>
            <input type="number" name="quantity" value="1" min="1" style="width: 70px; padding: 10px; border-radius: 12px; border: 1px solid #cbd5e1; font-weight: 700; text-align: center;">
          </div>

          <button type="submit" class="amie-button" style="width: 100%; justify-content: center; padding: 16px; font-size: 15px; background: #0082a6; cursor: pointer;">
            Add to Cart <span aria-hidden="true">→</span>
          </button>
        {% endform %}

        <!-- Trust Info Box -->
        <div style="margin-top: 32px; padding: 20px; border-radius: 16px; background: #faf8f5; border: 1px solid #e2e8f0; display: flex; flex-direction: column; gap: 10px; font-size: 13px; font-weight: 700; color: #1e293b;">
          <div>✓ Free shipping on orders above ₹999 across India</div>
          <div>✦ Safe &amp; gentle hypoallergenic fabric</div>
          <div>↻ Easy 7-day hassle-free returns</div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Details",
  "settings": []
}
{% endschema %}
